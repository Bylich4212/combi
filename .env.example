# ===== LAS 4 LLAVES QUE NECESITAS (ver GUIA.md) =====

# 1 y 2) Upstash Redis (la "memoria" donde se guardan los precios)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=tu_token

# 3) Token de tu bot (te lo da @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC...

# 4) Tu chat ID de Telegram (para que solo TÚ puedas usar los comandos de admin)
ADMIN_CHAT_ID=987654321

# Puerto del servidor (Render lo pone solo; en tu compu usa 3000)
PORT=3000
